{
  "name": "pi-subagent",
  "version": "0.1.0",
  "private": true,
  "description": "A tmux-based subagent extension for Pi.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "tmux",
    "subagent"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:integration": "node --test tests/integration.test.ts",
    "test:pi-api": "node tests/verify-pi.mjs",
    "test:pi-production": "node tests/verify-production-pi.mjs"
  },
  "pi": {
    "extensions": ["./index.ts"]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
