{
  "name": "pi-subagent",
  "version": "0.1.0",
  "private": true,
  "description": "Asynchronous, long-lived named subagents for Pi over the official RPC client.",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:integration": "node --test tests/cli-integration.test.ts",
    "test:rpc-probe": "node tests/rpc-cli.probe.ts"
  },
  "pi": {
    "extensions": ["./index.ts"]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
