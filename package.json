{
  "name": "pi-subagent",
  "version": "0.1.0",
  "description": "The official Pi subagent example, packaged so `pi install` also seeds the bundled agents and workflow prompts.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "subagent",
    "agent",
    "delegation"
  ],
  "files": [
    "extensions",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/subagent"
    ]
  },
  "scripts": {
    "postinstall": "node scripts/install.mjs",
    "seed": "node scripts/install.mjs"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  }
}
